// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Main database - stores user accounts and tenant database mappings
model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  password      String    // Hashed password for Next-Auth
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // Role & Access
  role          String    @default("LANDLORD") // "LANDLORD" | "TENANT" | "ADMIN"
  phoneNumber   String?   // For SMS reminders

  // Subscription & Plan
  subscriptionStatus String? // "free" | "active" | "canceled" | "past_due"
  stripeCustomerId   String? @unique
  stripeSubscriptionId String? @unique
  currentPlan        String  @default("free") // "free" | "pro"
  planStartDate      DateTime?
  planEndDate        DateTime?

  // Multi-tenant database
  tenantDatabaseName String? @unique // Name of their dedicated database
  tenantDatabaseUrl  String? // Full connection string to their database

  // Relations
  accounts     Account[]
  sessions     Session[]
  payments     Payment[]
  onboardingCompleted Boolean @default(false)

  @@map("users")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

// Admin system models
model AppUpdate {
  id          String   @id @default(cuid())
  version     String   @unique
  description String?  @db.Text
  changelog   String?  @db.Text
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  deployedAt DateTime?
  deployedBy  String?  // Admin user ID

  @@map("app_updates")
}

model Payment {
  id                String   @id @default(cuid())
  userId            String
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  stripePaymentId   String?  @unique
  amount            Decimal  @db.Decimal(10, 2)
  currency          String   @default("gbp")
  status            String   // "pending" | "succeeded" | "failed" | "refunded"
  plan              String   // "free" | "pro"
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([userId])
  @@index([status])
  @@map("payments")
}
