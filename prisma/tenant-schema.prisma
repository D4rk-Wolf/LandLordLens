// Tenant-specific database schema
// This schema is used for each user's dedicated database

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("TENANT_DATABASE_URL")
}

model Property {
  id          String    @id @default(cuid())
  address     String
  postcode    String
  city        String?
  propertyType String?  // "Flat" | "House" | "Bungalow" | etc.
  bedrooms    Int?
  bathrooms   Int?
  purchaseDate DateTime?
  propertyValueEstimate Decimal? @db.Decimal(12, 2) // For yield calculation
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  // Relations
  tenancies   Tenancy[]
  complianceRecords ComplianceRecord[]
  maintenanceTickets MaintenanceTicket[]
  transactions Transaction[]

  @@map("properties")
}

model Tenancy {
  id                    String    @id @default(cuid())
  tenantName            String
  tenantEmail           String?   // For tenant invitations
  startDate             DateTime
  endDate               DateTime? // Optional for ongoing tenancies
  monthlyRent           Decimal   @db.Decimal(10, 2)
  depositAmount         Decimal?  @db.Decimal(10, 2)
  depositProtectionScheme String? // e.g., "DPS", "TDS", "MyDeposits"
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  // Relations
  propertyId            String
  property              Property  @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  maintenanceTickets    MaintenanceTicket[]

  @@index([propertyId])
  @@index([endDate])
  @@map("tenancies")
}

model ComplianceType {
  id                String    @id @default(cuid())
  name              String    @unique // e.g., "Gas Safety Certificate"
  description       String?   @db.Text
  renewalFrequencyMonths Int  // e.g., 12 for annual renewal
  isRequired        Boolean   @default(true)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  // Relations
  complianceRecords ComplianceRecord[]

  @@map("compliance_types")
}

model ComplianceRecord {
  id                String    @id @default(cuid())
  lastCompletedDate DateTime
  nextDueDate       DateTime  // Calculated based on renewalFrequencyMonths
  documentUrl       String?   // URL to uploaded PDF (S3, Vercel Blob, etc.)
  notes             String?   @db.Text
  lastReminderSentAt DateTime? // Track when last reminder was sent
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  // Relations
  propertyId        String
  property          Property  @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  complianceTypeId  String
  complianceType    ComplianceType @relation(fields: [complianceTypeId], references: [id], onDelete: Cascade)

  @@index([propertyId])
  @@index([nextDueDate])
  @@index([complianceTypeId])
  @@map("compliance_records")
}

model MaintenanceTicket {
  id          String    @id @default(cuid())
  title       String
  description String    @db.Text
  priority    String    @default("MEDIUM") // "LOW" | "MEDIUM" | "HIGH" | "URGENT"
  status      String    @default("OPEN") // "OPEN" | "IN_PROGRESS" | "RESOLVED" | "CLOSED"
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  // Relations
  propertyId  String
  property    Property  @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  tenancyId   String?
  tenancy     Tenancy?  @relation(fields: [tenancyId], references: [id], onDelete: SetNull)
  reportedByUserId String? // Track who reported (for tenant portal)

  @@index([propertyId])
  @@index([status])
  @@index([priority])
  @@index([tenancyId])
  @@map("maintenance_tickets")
}

model Transaction {
  id          String    @id @default(cuid())
  type        String    // "INCOME" | "EXPENSE"
  amount      Decimal   @db.Decimal(10, 2)
  description String
  category    String    // "RENT" | "REPAIR" | "MANAGEMENT_FEE" | "UTILITIES" | "INSURANCE" | "TAX" | "OTHER"
  date        DateTime  @default(now())
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  // Relations
  propertyId  String
  property    Property  @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@index([propertyId])
  @@index([date])
  @@index([type])
  @@map("transactions")
}

