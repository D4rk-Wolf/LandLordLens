{
    "compilerOptions": {
        "target": "ES2022",
        "module": "CommonJS",
        "lib": [
            "ES2022"
        ],
        "outDir": "../dist/server",
        "rootDir": "..",
        "strict": true,
        "esModuleInterop": true,
        "skipLibCheck": true,
        "forceConsistentCasingInFileNames": true,
        "moduleResolution": "node",
        "resolveJsonModule": true,
        "removeComments": true,
        "allowJs": true,
        "noImplicitAny": true,
        "sourceMap": true,
        "baseUrl": "..",
        "paths": {
            "@models/*": [
                "models/*"
            ],
            "@middleware/*": [
                "lib/middleware/*"
            ],
            "@routes/*": [
                "server/routes/*"
            ],
            "@lib/*": [
                "lib/*"
            ]
        }
    },
    "include": [
        "../lib/**/*",
        "../models/**/*",
        "**/*.ts",
        "**/*.js"
    ],
    "exclude": [
        "../node_modules",
        "../tests"
    ]
}