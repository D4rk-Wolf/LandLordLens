{
  "framework": "nextjs",
  "installCommand": "cd ../.. && pnpm install --frozen-lockfile",
  "buildCommand": "cd ../.. && pnpm turbo run build --filter=@landlordlens/web",
  "functions": {
    "app/api/webhooks/stripe/route.ts": {
      "maxDuration": 30
    },
    "app/api/export/audit-pack/route.ts": {
      "maxDuration": 60
    },
    "app/api/cron/purge-deleted-accounts/route.ts": {
      "maxDuration": 60
    }
  },
  "crons": [
    {
      "path": "/api/cron/purge-deleted-accounts",
      "schedule": "0 2 * * *"
    }
  ]
}
