# Server Configuration
PORT=5000
NODE_ENV=production
FRONTEND_URL=http://localhost:3000
MONGODB_URI=mongodb://localhost:27017/landlordlens

# Security
JWT_SECRET=your_jwt_secret_key_here

# Client Side Configuration (Used in Build)
REACT_APP_API_URL=http://localhost:5000/api

# Stripe Payments Configuration
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICING_TABLE_ID=prctbl_...

# Stripe Price IDs (Copy from Stripe Dashboard)
STRIPE_PRICE_PROFESSIONAL_MONTHLY=price_...
STRIPE_PRICE_PROFESSIONAL_ANNUAL=price_...
STRIPE_PRICE_BUSINESS_MONTHLY=price_...
STRIPE_PRICE_BUSINESS_ANNUAL=price_...
STRIPE_PRICE_ENTERPRISE_MONTHLY=price_...
STRIPE_PRICE_ENTERPRISE_ANNUAL=price_...

# Sentry Error Monitoring
# SENTRY_DSN is exposed to the frontend via webpack DefinePlugin — use the Browser/Frontend DSN
# from Sentry Dashboard > Project Settings > Client Keys
SENTRY_DSN=https://your-key@oXXXXXX.ingest.sentry.io/XXXXXXX

# Source map upload (build environment only — never needed at runtime)
# Generate at Sentry Dashboard > Settings > Auth Tokens
SENTRY_AUTH_TOKEN=sntrys_...
SENTRY_ORG=your-org-slug
SENTRY_PROJECT=your-project-slug
