{
  "name": "landlordlens",
  "version": "2.0.0.0",
  "description": "A modern property management and compliance tracking system for UK landlords",
  "main": "server/index.js",
  "scripts": {
    "predev": "node scripts/ensure-deps.js",
    "dev": "concurrently \"npm run server\" \"npm run web\"",
    "web": "npx webpack serve --mode development --open",
    "server": "PORT=5000 nodemon server/index.js",
    "build": "npx webpack --mode production",
    "build:analyze": "npx webpack --mode production --analyze",
    "start": "node server/index.js",
    "create-demo-users": "node scripts/create-demo-users.js",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage"
  },
  "keywords": [
    "property-management",
    "react-native-web",
    "landlord"
  ],
  "author": "",
  "license": "UNLICENSED",
  "dependencies": {
    "@react-navigation/native": "^7.1.26",
    "@react-navigation/native-stack": "^7.9.0",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express-rate-limit": "^8.2.1",
    "express-validator": "^7.2.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^9.0.2",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "react-native": "^0.83.1",
    "react-native-web": "^0.21.2",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.0"
  },
  "devDependencies": {
    "@babel/core": "^7.26.0",
    "@babel/preset-env": "^7.26.0",
    "@babel/preset-react": "^7.26.0",
    "@babel/preset-typescript": "^7.26.0",
    "@stripe/stripe-js": "^8.6.0",
    "@testing-library/react": "^16.3.1",
    "@testing-library/react-native": "^13.3.3",
    "@testing-library/user-event": "^14.6.1",
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^25.0.3",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "@vercel/speed-insights": "^1.3.1",
    "babel-loader": "^10.0.0",
    "concurrently": "^9.1.0",
    "css-loader": "^7.1.2",
    "express": "^5.2.1",
    "find-up": "^8.0.0",
    "helmet": "^8.1.0",
    "hpp": "^0.2.3",
    "html-webpack-plugin": "^5.6.0",
    "jest": "^30.1.0",
    "jest-environment-jsdom": "^30.2.0",
    "lodash": "^4.17.21",
    "mongodb": "^7.0.0",
    "nodemon": "^3.1.11",
    "react-test-renderer": "^19.2.3",
    "stripe": "^20.1.0",
    "style-loader": "^4.0.0",
    "supertest": "^7.0.0",
    "tapable": "^2.3.0",
    "ts-loader": "^9.5.1",
    "typescript": "^5.7.2",
    "webpack": "^5.104.1",
    "webpack-bundle-analyzer": "^5.1.0",
