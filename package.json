{
  "name": "landlordlens",
  "version": "1.0.0",
  "description": "A modern property management and compliance tracking system for UK landlords",
  "main": "server/index.js",
  "scripts": {
    "dev": "concurrently \"npm run server\" \"npm run web\"",
    "web": "webpack serve --mode development --open",
    "server": "PORT=5000 nodemon server/index.js",
    "build": "webpack --mode production",
    "build:analyze": "webpack --mode production --analyze",
    "start": "node server/index.js",
    "create-demo-users": "node scripts/create-demo-users.js"
  },
  "keywords": [
    "property-management",
    "react-native-web",
    "landlord"
  ],
  "author": "",
  "license": "UNLICENSED",
  "dependencies": {
    "@react-navigation/native": "^6.1.9",
    "@react-navigation/native-stack": "^6.9.17",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.0.3",
    "react": "18.2.0",
    "react-dom": "18.2.0",
    "react-native": "^0.73.0",
    "react-native-web": "^0.19.10",
    "stripe": "^14.21.0"
  },
  "devDependencies": {
    "@babel/core": "^7.23.5",
    "@babel/preset-env": "^7.23.5",
    "@babel/preset-react": "^7.23.3",
    "@babel/preset-typescript": "^7.23.3",
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/node": "^20.10.5",
    "@types/react": "^18.2.43",
    "@types/react-dom": "^18.2.17",
    "babel-loader": "^9.1.3",
    "concurrently": "^8.2.2",
    "css-loader": "^6.8.1",
    "html-webpack-plugin": "^5.6.0",
    "mongodb": "^7.0.0",
    "nodemon": "^3.1.11",
    "style-loader": "^3.3.3",
    "ts-loader": "^9.5.1",
    "typescript": "^5.3.3",
    "webpack": "^5.104.1",
    "webpack-cli": "^5.1.4",
    "webpack-dev-server": "^5.2.2"
  }
