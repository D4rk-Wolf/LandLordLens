{
  "name": "landlordlens",
  "version": "2.0.0.0",
  "description": "A modern property management and compliance tracking system for UK landlords",
  "main": "server/index.js",
  "scripts": {
    "predev": "node scripts/ensure-deps.js",
    "dev": "concurrently \"npm run server\" \"npm run web\"",
    "web": "npx webpack serve --mode development --open",
    "server": "PORT=5000 nodemon --exec 'npx ts-node' server/index.ts",
    "build": "npx webpack --mode production",
    "build:server": "npx tsc -p server/tsconfig.json",
    "build:analyze": "npx webpack --mode production --analyze",
    "start": "node dist/server/server/index.js",
    "create-demo-users": "node scripts/create-demo-users.js",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "lint": "ESLINT_USE_FLAT_CONFIG=false eslint \"src/**/*.{ts,tsx}\"",
    "analyze": "source-map-explorer 'dist/js/*.js' --html dist/bundle-analysis.html"
  },
  "keywords": [
    "property-management",
    "react-native-web",
    "landlord"
  ],
  "author": "D4rkWolf Studios",
  "license": "LICENSED",
  "sideEffects": [
    "*.css"
  ],
  "dependencies": {
    "@react-navigation/native": "^7.1.26",
    "@react-navigation/native-stack": "^7.9.0",
    "compression": "^1.8.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^5.2.1",
    "express-rate-limit": "^8.2.1",
    "express-validator": "^7.2.0",
    "helmet": "^8.1.0",
    "hpp": "^0.2.3",
    "jsonwebtoken": "^9.0.2",
    "lodash": "^4.17.21",
    "multer": "^2.0.2",
    "pdf-parse": "^2.4.5",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "react-native": "^0.83.1",
    "react-native-web": "^0.21.2",
    "stripe": "^20.1.0",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.0",
    "tesseract.js": "^7.0.0"
  },
  "devDependencies": {
    "@babel/core": "^7.26.0",
    "@babel/preset-env": "^7.26.0",
    "@babel/preset-react": "^7.26.0",
    "@babel/preset-typescript": "^7.26.0",
    "@sentry/node": "^10.33.0",
    "@sentry/profiling-node": "^10.33.0",
    "@sentry/react": "^10.53.1",
    "@sentry/webpack-plugin": "^5.3.0",
    "@stripe/stripe-js": "^8.6.0",
    "@supabase/supabase-js": "^2.105.4",
    "@tanstack/react-query": "^5.90.16",
    "@testing-library/react": "^16.3.1",
    "@testing-library/react-native": "^13.3.3",
    "@testing-library/user-event": "^14.6.1",
    "@types/compression": "^1.8.1",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/hpp": "^0.2.7",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/lodash": "^4.17.21",
    "@types/multer": "^2.0.0",
    "@types/node": "^25.0.3",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "@types/swagger-jsdoc": "^6.0.4",
    "@types/swagger-ui-express": "^4.1.8",
    "@typescript-eslint/eslint-plugin": "^8.51.0",
    "@typescript-eslint/parser": "^8.51.0",
    "@vercel/speed-insights": "^1.3.1",
    "babel-loader": "^10.0.0",
    "compression-webpack-plugin": "^11.1.0",
    "concurrently": "^9.1.0",
    "css-loader": "^7.1.2",
    "eslint": "^9.39.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "find-up": "^8.0.0",
    "html-webpack-plugin": "^5.6.5",
    "jest": "^30.1.0",
    "jest-environment-jsdom": "^30.2.0",
    "nodemon": "^3.1.11",
    "react-router": "^7.12.0",
    "react-router-dom": "^7.12.0",
    "react-test-renderer": "^19.2.3",
    "source-map-explorer": "^2.5.3",
    "style-loader": "^4.0.0",
    "supertest": "^7.0.0",
    "tapable": "^2.3.0",
    "terser-webpack-plugin": "^5.3.16",
    "ts-loader": "^9.5.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.7.2",
    "webpack": "^5.104.1",
    "webpack-bundle-analyzer": "^5.1.0",
    "webpack-cli": "^6.0.1",
    "webpack-dev-server": "^5.2.2",
    "webpack-sources": "^3.3.3",
    "winston": "^3.19.0"
  }
}
